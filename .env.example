# =========================================================================
#  MF AR Workstation — environment configuration
#
#  Copy to .env and fill in the secrets:      cp .env.example .env
#  NEVER commit .env. It is listed in .gitignore.
# =========================================================================

# ---- Database -----------------------------------------------------------
POSTGRES_USER=portal
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
POSTGRES_DB=mf_ar_workstation
POSTGRES_PORT=5432

# Used when running the backend outside Docker. Inside Docker Compose the
# backend builds this automatically from the POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg2://portal:CHANGE_ME@localhost:5432/mf_ar_workstation

# ---- Application security ----------------------------------------------
# Signs the JWTs. Rotating it signs everyone out.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

ENVIRONMENT=development           # development | production
LOG_LEVEL=INFO

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_IDLE_TIMEOUT_MINUTES=480

# Set COOKIE_SECURE=true as soon as the portal is served over HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---- Brute-force protection ---------------------------------------------
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# ---- Password policy ----------------------------------------------------
PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY_DEPTH=5

# ---- Web ----------------------------------------------------------------
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
FRONTEND_PORT=8080
BACKEND_PORT=8000

# ---- First-run bootstrap ------------------------------------------------
# RUN_SEED creates roles, categories and the administrator account. It is
# idempotent: an existing admin is never modified.
RUN_SEED=true
# SEED_DEMO_DATA also creates sample employees and projects. Development only.
SEED_DEMO_DATA=false

FIRST_ADMIN_EMPLOYEE_ID=ADMIN001
FIRST_ADMIN_NAME=System Administrator
FIRST_ADMIN_EMAIL=admin@example.com
# Leave blank to have a strong password generated and printed ONCE in the
# backend logs at first start. Must meet the password policy if you set it.
FIRST_ADMIN_PASSWORD=
