# Backend configuration for running the API directly (without Docker).
# Copy to backend/.env — never commit the real file.

# ---- Database -----------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://portal:CHANGE_ME@localhost:5432/mf_ar_workstation
SQL_ECHO=false

# ---- Security -----------------------------------------------------------
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ENVIRONMENT=development
LOG_LEVEL=INFO

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_IDLE_TIMEOUT_MINUTES=480

COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---- Brute-force protection ---------------------------------------------
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# ---- Password policy ----------------------------------------------------
PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY_DEPTH=5

# ---- CORS ---------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- First-run bootstrap ------------------------------------------------
FIRST_ADMIN_EMPLOYEE_ID=ADMIN001
FIRST_ADMIN_NAME=System Administrator
FIRST_ADMIN_EMAIL=admin@example.com
# Leave blank to have a strong password generated and printed once.
FIRST_ADMIN_PASSWORD=
